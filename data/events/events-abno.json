    "ageRange": [15, 100],
    "weight": 4,
    "repeatable": true,
    "cooldown": 6,
    "branches": [
      {
        "id": "b1",
        "text": "与它对视，尝试交流。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "synergy", "operator": ">=", "value": 5 }, { "attribute": "will", "operator": ">=", "value": 4 } ] },
        "effects": { "synergy": 1, "pressure": -5, "instinct": 1 }
      },
      { "id": "b2", "text": "缓缓后退，保持距离。", "effects": { "instinct": 1 } },
      { "id": "b3", "text": "逃跑。", "effects": { "pressure": 8, "fortune": -1 } }
    ],
    "portrait": "abno",
    "pressureGain": 5,
    "tags": ["abno"]
  },
  {
