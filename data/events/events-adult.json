    "ageRange": [19, 35],
    "weight": 8,
    "repeatable": false,
    "branches": [
      {
        "id": "b1",
        "text": "循着线索追查到后巷，与窃贼对峙。",
        "conditions": { "attribute": "physique", "operator": ">=", "value": 4 },
        "effects": { "reputation": 6, "wealth": 300, "physique": 1 }
      },
      {
        "id": "b2",
        "text": "用口才说服窃贼交出义手。",
        "conditions": { "attribute": "fortune", "operator": ">=", "value": 3 },
        "effects": { "reputation": 4, "wealth": 300, "fortune": 1 }
      },
      { "id": "b3", "text": "买一只仿品交差。", "effects": { "wealth": -200, "will": -1 } }
    ],
    "portrait": "fixer",
    "tags": ["fixer", "adult"]
  },
  {
