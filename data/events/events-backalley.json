[
  {
    "id": 601,
    "title": "巷口的清晨",
    "description": "清晨的后巷，雾气弥漫。早餐摊冒着热气，摊主是位沉默寡言的老者。一碗热腾腾的杂烩汤下肚，你感觉又能撑过一天。",
    "type": "backalley",
    "ageRange": [13, 100],
    "weight": 8,
    "repeatable": true,
    "cooldown": 2,
    "branches": [
      { "id": "b1", "text": "付钱喝汤，和摊主闲聊几句。", "effects": { "health": 3, "synergy": 1 } },
      { "id": "b2", "text": "赊账。等有钱了再还。", "effects": { "wealth": -100, "fortune": -1 } }
