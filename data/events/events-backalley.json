  {
    "id": 607,
    "title": "流浪歌手",
    "description": "一位歌手在巷口弹唱。她的歌声很好听，却带着说不出的哀伤。后来你才知道，她是第九区的流亡音乐家——钢琴家事件后，音乐在第九区成了禁忌。",
    "type": "backalley",
    "ageRange": [15, 100],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "听她唱完，留一点钱。", "effects": { "synergy": 1, "wealth": -100, "pressure": -5 } },
      { "id": "b2", "text": "劝她别再唱歌，会招来麻烦。", "effects": { "instinct": 1, "pressure": 3 } }
    ],
    "portrait": "singer",
    "tags": ["backalley"]
  },
  {
    "id": 608,
    "title": "深宵的巨响",
    "description": "凌晨三点十三分，后巷传来一声巨响。你透过窗帘缝隙，看到清道夫们在清理什么。深宵的禁忌规定：任何惨剧都不得被追究。你选择了沉默。",
    "type": "backalley",
    "ageRange": [18, 100],
