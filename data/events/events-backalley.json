  {
    "id": 603,
    "title": "指使",
    "description": "一名食指的苦行者出现在巷口，递给每个人一张信纸。信纸上写着奇怪的指令：'为第六巷口的石像浇一杯水。'完成指令的人会得到奖励——不完成的人，后果自负。",
    "type": "finger",
    "ageRange": [15, 100],
    "weight": 4,
    "repeatable": true,
    "cooldown": 5,
    "branches": [
      { "id": "b1", "text": "照做。不过一杯水而已。", "effects": { "wealth": 300, "fortune": 1 } },
      { "id": "b2", "text": "无视指令。我不信这套。", "effects": { "pressure": 8, "fortune": -1 } }
    ],
    "portrait": "finger",
    "tags": ["finger", "backalley"]
