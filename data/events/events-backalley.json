  {
    "id": 604,
    "title": "邻里守望",
    "description": "后巷的邻里守望组织在招募人手。他们负责维持巷子的最低限度治安——没工资，但遇到麻烦时，邻居会来帮你。",
    "type": "backalley",
    "ageRange": [18, 80],
    "weight": 5,
    "repeatable": false,
    "branches": [
