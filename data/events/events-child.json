    "portrait": "fear",
    "pressureGain": 5,
    "tags": ["deep-night", "trauma"]
  },
  {
    "id": 5,
    "title": "巷子里的学校",
    "description": "后巷没有正规学校，只有巷口那间由退休收尾人开的'安全屋学堂'。教识字、教算术、教如何从帮派冲突里活下来。",
    "type": "child",
    "ageRange": [5, 10],
    "weight": 8,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "认真听课，老师讲的故事里藏着活命的智慧。", "effects": { "intelligence": 1, "instinct": 1 } },
      { "id": "b2", "text": "逃课去巷口看收尾人处理委托。", "effects": { "physique": 1, "reputation": 2 } }
