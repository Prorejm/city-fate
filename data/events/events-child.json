[
  {
    "id": 1,
    "title": "第一声啼哭",
    "description": "你在都市的某条巷子、某间巢房里降生了。产婆剪断脐带，窗外传来后巷特有的轰鸣。你的命运，从这一秒开始转动。",
    "type": "child",
    "ageRange": [0, 0],
    "weight": 10,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "安静地注视着这个灰色的世界。", "effects": { "instinct": 1 }, "portrait": "calm" },
      { "id": "b2", "text": "放声大哭，惊动了整条巷子。", "effects": { "physique": 1 }, "portrait": "cry" }
    ],
    "portrait": "baby",
    "tags": ["birth"]
  },
  {
    "id": 2,
    "title": "巷口的第一次试探",
    "description": "你刚学会走路，就踉跄着爬到了巷口。污水沟里漂着废弃的零件，远处传来帮派成员的吆喝声。母亲一把将你拽了回去。",
    "type": "child",
    "ageRange": [2, 4],
    "weight": 8,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "挣扎着想要再看一眼外面的世界。", "effects": { "instinct": 1, "will": 1 } },
      { "id": "b2", "text": "顺从地被母亲抱回屋内。", "effects": { "synergy": 1 } }
    ],
    "portrait": "curious",
    "tags": ["childhood"]
  },
  {
    "id": 3,
    "title": "拾荒的学费",
    "description": "父母教你辨认哪些废品能卖钱：黄铜管线、回收电池、偶尔出现的完好零件。捡到好东西，今天的晚饭就能多一块肉。",
    "type": "child",
    "ageRange": [3, 7],
    "weight": 8,
    "repeatable": true,
    "cooldown": 2,
    "branches": [
      { "id": "b1", "text": "认真地学习辨认，成为巷子里的小拾荒专家。", "effects": { "intelligence": 1, "wealth": 100 } },
