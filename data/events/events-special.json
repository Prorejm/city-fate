[
  {
    "id": 1201,
    "title": "白夜",
    "description": "那一年，天空裂开了。三日夜的完全光芒笼罩都市——高塔般的大树破土而出，向世界撒落她的果实。你的皮肤在光芒下发烫，有什么东西正在你体内苏醒。",
    "type": "special",
    "ageRange": [10, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      {
        "id": "b1",
        "text": "在光芒中睁大眼睛，记住这一刻。",
        "conditions": { "attribute": "synergy", "operator": ">=", "value": 4 },
        "effects": { "synergy": 2, "pressure": 10 }, "grantTrait": "seed-of-light"
      },
      { "id": "b2", "text": "躲进屋里，捂住眼睛。", "effects": { "pressure": 8 } }
    ],
    "portrait": "light",
    "pressureGain": 12,
    "tags": ["special", "white-night", "key:white-night"]
  },
  {
    "id": 1202,
    "title": "黑昼",
    "description": "光芒戛然而止。四个日夜，都市陷入完全的黑暗。没有星光，没有月光，连后巷的霓虹都熄灭了。黑暗中，你听见了无数人压抑的呼吸。",
    "type": "special",
    "ageRange": [10, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "在黑暗中摸索前行，寻找食物。", "effects": { "instinct": 1, "health": -3 } },
      { "id": "b2", "text": "蜷缩在角落，等待黎明。", "effects": { "will": 1, "pressure": 8 } }
    ],
    "portrait": "dark",
    "pressureGain": 10,
    "tags": ["special", "white-night"]
  },
  {
    "id": 1203,
    "title": "钢琴家",
    "description": "第九区出现了都市的第一例扭曲——'钢琴家'。它弹奏着名为'音乐'的灾难，三十余万听众化作音符消散。你的街区正在被琴声波及。",
    "type": "special",
    "ageRange": [15, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      {
        "id": "b1",
        "text": "捂住耳朵，拼命逃离琴声范围。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "physique", "operator": ">=", "value": 5 }, { "attribute": "instinct", "operator": ">=", "value": 5 } ] },
        "effects": { "health": -10, "fortune": 1 }
      },
      { "id": "b2", "text": "在远处听完了那场'音乐会'。", "effects": { "synergy": 1, "pressure": 20, "will": -1 } }
    ],
    "portrait": "piano",
    "pressureGain": 15,
    "tags": ["special", "key:piano"]
  },
  {
    "id": 1204,
    "title": "烟霾战争",
    "description": "第十二区爆发了烟霾战争。惨白的浓烟扩散到整个巢——旧L公司的奇点泄露了。七十天的混战里，各路势力与不明怪物在浓烟中厮杀。你的世界只剩下白色。",
    "type": "special",
    "ageRange": [15, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      {
        "id": "b1",
        "text": "戴上简陋的滤布，在浓烟中求生。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "physique", "operator": ">=", "value": 5 }, { "attribute": "fortune", "operator": ">=", "value": 3 } ] },
        "effects": { "health": -8, "instinct": 1 }
      },
      { "id": "b2", "text": "逃离第十二区。", "effects": { "fortune": -1, "pressure": 8 } }
    ],
    "portrait": "smog",
    "pressureGain": 12,
    "tags": ["special", "key:smog-war"]
  },
  {
    "id": 1205,
    "title": "机械肃清之日",
    "description": "十四区爆发了'机械肃清之日'——一场针对义体的狩猎。武装的猎手在街上拦截义体使用者，无辜者与改造者一同被拖走。你看着那条街，血流成河。",
    "type": "special",
    "ageRange": [20, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "躲起来，直到肃清结束。", "effects": { "pressure": 12, "will": -1 } },
      {
        "id": "b2",
        "text": "帮助被追捕的义体使用者藏身。",
        "conditions": { "attribute": "synergy", "operator": ">=", "value": 5 },
        "effects": { "synergy": 1, "reputation": 4, "pressure": 8 }
      }
    ],
    "portrait": "purge",
    "pressureGain": 12,
    "tags": ["special", "n-corp"]
  },
  {
    "id": 1206,
    "title": "图书馆建立",
    "description": "一座扭曲的'图书馆'在都市某处建立。它收纳'书籍'——而被做成书的人，从不会回来。收尾人圈子流传着它的传说，一批又一批的收尾人鱼贯而入，杳无音信。",
    "type": "special",
    "ageRange": [20, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "远离那座图书馆。好奇心会杀人。", "effects": { "instinct": 1 } },
      {
        "id": "b2",
        "text": "前往图书馆，成为司书候选人。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "synergy", "operator": ">=", "value": 6 }, { "attribute": "will", "operator": ">=", "value": 6 } ] },
        "effects": { "reputation": 20, "synergy": 2 }, "setIdentity": "librarian", "setAffiliation": "图书馆"
      }
    ],
    "portrait": "library",
    "pressureGain": 10,
    "tags": ["special", "library"]
  },
  {
    "id": 1207,
    "title": "边狱巴士启程",
    "description": "你目睹了一辆奇怪的巴士驶入都市地下。车身上印着'边狱公司'的标志，十三名罪人鱼贯登车。据说，他们要前往都市的各个角落，取回金枝。",
    "type": "special",
    "ageRange": [20, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "远远地看着，记下这一切。", "effects": { "intelligence": 1, "synergy": 1 } },
      {
        "id": "b2",
        "text": "上前询问招募事宜。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "will", "operator": ">=", "value": 6 }, { "attribute": "synergy", "operator": ">=", "value": 5 } ] },
        "effects": { "reputation": 15 }, "setIdentity": "limbus-manager", "setAffiliation": "边狱公司"
      }
    ],
    "portrait": "bus",
    "tags": ["special", "limbus"]
  },
  {
    "id": 1208,
    "title": "鸿园更替",
    "description": "第八区的鸿园正值家主评选更替。仙人们与黑兽在暗处交锋，新任家主将移植传承记忆的'仙皇虫'。整个鸿园弥漫着山雨欲来的气息。",
    "type": "special",
    "ageRange": [25, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "静观其变。神仙打架，凡人退散。", "effects": { "instinct": 1 } },
      {
        "id": "b2",
        "text": "押注一位候选人。",
        "conditions": { "attribute": "fortune", "operator": ">=", "value": 5 },
        "effects": { "wealth": 2000, "pressure": 8 }
      }
    ],
    "portrait": "h-corp",
    "pressureGain": 8,
    "tags": ["special", "h-corp"]
  },
  {
    "id": 1209,
    "title": "大湖五灾",
    "description": "大湖的水面突然涌起巨浪——马林鲸鱼，大湖五灾之一，正在接近。船上的老水手脸色煞白：'它来了。我们跑不掉了。'",
    "type": "special",
    "ageRange": [30, 90],
    "weight": 3,
    "repeatable": false,
    "branches": [
      {
        "id": "b1",
        "text": "操起鱼叉，与它一战。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "physique", "operator": ">=", "value": 7 }, { "attribute": "will", "operator": ">=", "value": 5 } ] },
        "effects": { "reputation": 15, "wealth": 5000, "health": -15 }
      },
      { "id": "b2", "text": "跳船逃生。", "effects": { "health": -10, "fortune": -1 } }
    ],
    "portrait": "whale",
    "pressureGain": 12,
    "tags": ["special", "danger"]
  },
  {
    "id": 1210,
    "title": "后巷深宵·清道夫",
    "description": "你在后巷深宵被清道夫盯上了。它们成群结队，从一个巢扫荡至另一个巢。你必须在八十分钟内找到藏身处——或者，成为它们清扫的'垃圾'。",
    "type": "special",
    "ageRange": [15, 100],
    "weight": 3,
    "repeatable": true,
    "cooldown": 15,
    "branches": [
      {
        "id": "b1",
        "text": "凭借对巷子的熟悉，绕开清扫路线。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "instinct", "operator": ">=", "value": 6 }, { "attribute": "physique", "operator": ">=", "value": 4 } ] },
        "effects": { "instinct": 1, "pressure": 8 }
      },
      { "id": "b2", "text": "躲进废弃的下水道。", "effects": { "pressure": 10, "health": -3 } },
      { "id": "b3", "text": "与清道夫正面遭遇。", "effects": { "health": -30, "pressure": 15 }, "deathChainId": "deep-night" }
    ],
    "portrait": "sweeper",
    "pressureGain": 12,
    "tags": ["special", "deep-night", "key:deep-night"]
  },
  {
    "id": 1211,
    "title": "首脑的注视",
    "description": "不知为何，你感觉有一道目光正从都市的顶点投下。是眼线？是首脑？还是爪牙？你后颈发凉，却什么也看不见。被都市的统治者注视，绝非好事。",
    "type": "special",
    "ageRange": [20, 100],
    "weight": 2,
    "repeatable": true,
    "cooldown": 20,
    "branches": [
      { "id": "b1", "text": "低头，装作普通市民。", "effects": { "instinct": 1, "pressure": 8 } },
      { "id": "b2", "text": "抬头直视那道目光。", "effects": { "will": 1, "pressure": 15 } }
    ],
    "portrait": "head",
    "pressureGain": 10,
    "tags": ["special", "head"]
  },
  {
    "id": 1212,
    "title": "星星的愿望",
    "description": "郊外某处的夜空，群星突然变得异常明亮。传说中，星星能以神秘的方式实现愿望——但代价是什么，没有人说得清。你仰望星空，心中的愿望翻涌。",
    "type": "special",
    "ageRange": [25, 100],
    "weight": 2,
    "repeatable": false,
    "branches": [
      {
        "id": "b1",
        "text": "许下一个愿望。",
        "conditions": { "attribute": "synergy", "operator": ">=", "value": 6 },
        "effects": { "fortune": 2, "pressure": 5 }
      },
      { "id": "b2", "text": "愿望是危险的，转身离开。", "effects": { "will": 1 } }
    ],
    "portrait": "star",
    "tags": ["special", "star"]
  },
  {
    "id": 1213,
    "title": "奇点事故",
    "description": "翼公司的实验区发生了奇点泄露。扭曲的光在走廊里蔓延，工作人员尖叫着逃离。你正好在场——要么帮忙疏散，要么趁乱偷取样品。",
    "type": "special",
    "ageRange": [25, 90],
    "weight": 2,
    "repeatable": true,
    "cooldown": 15,
    "branches": [
      {
        "id": "b1",
        "text": "协助疏散，在翼公司留个好印象。",
        "conditions": { "op": "AND", "conditions": [ { "attribute": "intelligence", "operator": ">=", "value": 6 }, { "attribute": "synergy", "operator": ">=", "value": 4 } ] },
        "effects": { "reputation": 10, "intelligence": 1, "pressure": 8 }
      },
      {
        "id": "b2",
        "text": "趁乱偷取奇点样品。",
        "conditions": { "attribute": "instinct", "operator": ">=", "value": 6 },
        "effects": { "wealth": 1200, "instinct": 1, "pressure": 12, "synergy": 1 }
      },
      { "id": "b3", "text": "转身就走，离得越远越好。", "effects": { "pressure": 5 } }
    ],
    "portrait": "wing",
    "pressureGain": 8,
    "tags": ["special", "singularity", "wing"]
  },
  {
    "id": 1214,
    "title": "专利禁忌",
    "description": "你无意间得知一个秘密：某个工坊在未经授权的情况下仿制了翼公司的奇点。这是头号禁忌——仿制奇点，等于向首脑宣战。你该如何处置这个秘密？",
    "type": "special",
    "ageRange": [25, 90],
    "weight": 2,
    "repeatable": true,
    "cooldown": 18,
    "branches": [
      { "id": "b1", "text": "向翼公司举报，换取赏金。", "effects": { "wealth": 1500, "reputation": 5, "pressure": 5 } },
      {
        "id": "b2",
        "text": "向工坊索取封口费。",
        "conditions": { "attribute": "will", "operator": ">=", "value": 6 },
        "effects": { "wealth": 2000, "pressure": 10, "reputation": -5 }
      },
      { "id": "b3", "text": "装作什么都不知道。", "effects": { "will": 1, "pressure": 3 } }
    ],
    "portrait": "claw",
    "pressureGain": 8,
    "tags": ["special", "taboo", "claw"]
  },
  {
    "id": 1215,
    "title": "脑啡肽黑市",
    "description": "后巷的暗市里，有人偷偷出售L公司的脑啡肽。这是被严格管制的物资——但黑市的货，往往带着'故事'。卖家看着你：'要多少？'",
    "type": "special",
    "ageRange": [25, 90],
    "weight": 3,
    "repeatable": true,
    "cooldown": 12,
    "branches": [
      {
        "id": "b1",
        "text": "买下所有脑啡肽。",
        "conditions": { "attribute": "wealth", "operator": ">=", "value": 800 },
        "effects": { "wealth": -800, "pressure": -20, "synergy": 1 }
      },
      { "id": "b2", "text": "举报这个黑市窝点。", "effects": { "reputation": 6, "pressure": 5 } },
      { "id": "b3", "text": "只是看看，然后离开。", "effects": { "instinct": 1 } }
    ],
    "portrait": "enkephalin",
    "tags": ["special", "singularity", "blackmarket"]
  }
]
