[
  {
    "id": 9000,
    "title": "内心低语",
    "description": "深夜，你听见了一个声音。它甜美、温柔，仿佛来自你内心最深处的某个角落。'终于……听到你了。'你猛地惊醒，冷汗浸透衣背。是梦吗？",
    "type": "voice",
    "ageRange": [16, 150],
    "weight": 10,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "那一定是幻觉。睡吧。", "effects": { "pressure": 5, "will": -1 } },
      { "id": "b2", "text": "细听那个声音，它似乎有话要说。", "effects": { "synergy": 1, "pressure": 10 } }
    ],
    "portrait": "voice",
    "pressureGain": 8,
    "tags": ["voice"]
  },
  {
    "id": 9001,
    "title": "叩问自我",
    "description": "那个声音再次响起，这一次，它清晰得无法忽视：'你愿意，看见真正的自己吗？'四周的世界仿佛静止。你的痛苦、你的罪孽、你的一切，都浮现在眼前。这是最后的选择。",
    "type": "voice",
    "ageRange": [16, 150],
    "weight": 99,
    "repeatable": false,
    "voiceTrigger": true,
    "branches": [
      {
        "id": "b1",
        "text": "『我接受我的痛苦，也接受我的罪孽。』——直面一切，拥抱真正的自己。",
        "outcome": "ego",
        "effects": { "pressure": -20, "will": 1 }
      },
      {
        "id": "b2",
        "text": "『我承受了太多痛苦，罪孽不属于我。』——只承认受害者的自己。",
        "outcome": "distortion",
        "effects": { "distortion": 25, "pressure": -10 }
      },
      {
        "id": "b3",
        "text": "『我不想看到任何真实的自己。』——闭上眼睛，拒绝一切。",
        "outcome": "sin",
        "effects": { "pressure": 30 }
      }
    ],
    "portrait": "self",
    "pressureGain": 20,
    "tags": ["voice", "critical"]
  },
  {
    "id": 9002,
    "title": "光芒的形态",
    "description": "你的内心被光芒贯穿。痛苦与罪孽在你手中凝聚成实体——那是独属于你的、无法复制的力量。你的 E.G.O 觉醒了。",
    "type": "voice",
    "ageRange": [16, 150],
    "weight": 1,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "握住它。这就是我。", "effects": { "will": 1, "synergy": 1, "health": 10 } }
    ],
    "portrait": "ego",
    "tags": ["voice", "ego"]
  },
  {
    "id": 9003,
    "title": "扭曲的拥抱",
    "description": "你只接受了痛苦，却拒绝承认罪孽。那个声音叹息着，化作温暖却诡异的怀抱。你的身体开始变化——以一种只属于你的方式。",
    "type": "voice",
    "ageRange": [16, 150],
    "weight": 1,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "接受变化。这是'我'的一部分。", "effects": { "distortion": 30, "physique": 1 } }
    ],
    "portrait": "distorted",
    "tags": ["voice", "distortion"]
  },
  {
    "id": 9004,
    "title": "心望修习",
    "description": "你没有觉醒 E.G.O，却在漫长的人生中领悟了另一种力量：心望。心用于防御，望用于攻击。将内心的愿望汇聚为力量，你做到了。",
    "type": "voice",
    "ageRange": [30, 150],
    "weight": 3,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "修习心望。", "conditions": { "op": "AND", "conditions": [ { "attribute": "will", "operator": ">=", "value": 6 }, { "attribute": "synergy", "operator": ">=", "value": 5 } ] }, "effects": { "will": 1, "synergy": 1, "health": 5 } },
      { "id": "b2", "text": "普通人的力量，也够用了。", "effects": { "pressure": -8 } }
    ],
    "portrait": "heart",
    "tags": ["voice"]
  },
  {
    "id": 9005,
    "title": "低语的告别",
    "description": "自从你选择拥抱真实自我之后，那个甜美的声音再也没有响起。深夜，你偶尔会怀念它。但你知道，你已经不需要它了。",
    "type": "voice",
    "ageRange": [16, 150],
    "weight": 1,
    "repeatable": false,
    "branches": [
      { "id": "b1", "text": "谢谢。再见了。", "effects": { "synergy": 1, "will": 1, "pressure": -15 } }
    ],
    "portrait": "calm",
    "tags": ["voice", "ego"]
  }
